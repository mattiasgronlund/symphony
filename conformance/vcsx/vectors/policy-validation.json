{
  "function": "validate_policy",
  "spec_refs": [
    "VCSX-SPEC.md Section 6.1 \"File Discovery and `vcsx.toml` Merge\"",
    "VCSX-SPEC.md Section 6.10 \"Validation\"",
    "VCSX-SPEC.md Section 4.1 \"Operation Set\"",
    "VCSX-SPEC.md Section 5.4 \"Unmatched Policy and Determinism\"",
    "VCSX-SPEC.md Section 5.6 \"Flow Bound and Termination\"",
    "VCSX-SPEC.md Section 6.4 \"`[base]` and Base Resolution\"",
    "VCSX-SPEC.md Section 6.7 \"`tracker.transitions`\"",
    "VCSX-SPEC.md Section 8.5 \"Versioning and the Version Grammar\""
  ],
  "description": "Validate a repository policy before use. On a configuration error the engine refuses to run and does not run a partial policy.",
  "given": "the four inputs Section 6.10 names: the policy, what the engine holds independently of the invocation (here its running version; backend descriptors are not modelled, see notes), the actions the consumer can effect, and the repository units it bound",
  "expect": "`{ valid: true }`, or `{ error: <config reason> }` naming the Section 6.10 reason the refusal carries",
  "notes": [
    "Each failing vector holds exactly one condition, so the reported reason is determined. Which reason is reported when several conditions hold is Implementation-defined (Section 6.10) and is deliberately not exercised here.",
    "`consumer_capabilities` lists the consumer-effected actions (Section 5.2) this consumer can perform. An empty list models a human at an interactive prompt (Section 1.3).",
    "`bound_units` lists the repository units the consumer bound (Section 6.10), which is the input `template_unbound` is judged from — a template is a Section 10.2 repository unit rather than a Section 5.2 action, so `consumer_capabilities` does not reach it. A vector omitting the key is read as an empty list.",
    "`capability_unsupported` (Sections 6.10, 9.3) is not exercised here: it is determined against a plugin capability descriptor, which this slice defers with the rest of plugin behavior. Its absence is a coverage gap, not a statement that the condition is unvalidated.",
    "`malformed_policy` for a policy file that does not parse (Sections 6.1, 6.10) is not exercised here either: `given.policy` is a document, not file text, so the input this condition is judged from cannot be expressed in this file. The other two well-formedness conditions are judged from a parsed document and are exercised. Its absence is likewise a coverage gap, not a statement that the condition is unvalidated."
  ],
  "vectors": [
    {
      "id": "minimal_valid_policy",
      "given": {
        "policy": {
          "engine": { "version_floor": "1.0" },
          "base": { "branch": "main" },
          "hooks": { "scan-content": { "context": "in_sandbox", "run": "./scan" } },
          "edges": [
            { "on": "before:commit", "do": "run", "hook": "scan-content" },
            { "on": "push:non_fast_forward", "do": "run_op", "op": "integrate" },
            { "on": "#error", "do": "escalate" }
          ]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "valid": true }
    },
    {
      "id": "duplicate_edge_is_non_deterministic",
      "description": "At most one edge per (from-context, trigger); a duplicate is a configuration error (Section 5.4).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [
            { "on": "push:non_fast_forward", "do": "run_op", "op": "integrate" },
            { "on": "push:non_fast_forward", "do": "escalate" }
          ]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "duplicate_edge" }
    },
    {
      "id": "same_trigger_at_different_from_contexts_is_valid",
      "description": "The key is (from-context, trigger), so a from-context distinguishes two transition edges on one trigger (Section 5.4).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [
            { "from": "In Progress", "on": "ready-for-review", "do": "set_state", "target": "Human Review" },
            { "from": "Human Review", "on": "ready-for-review", "do": "set_state", "target": "Done" }
          ]
        },
        "engine_version": "1.3",
        "consumer_capabilities": ["set_state"]
      },
      "expect": { "valid": true }
    },
    {
      "id": "duplicate_transition_is_non_deterministic",
      "description": "At most one `to` per (from, on) in the transition graph (Section 6.7).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [],
          "tracker_transitions": [
            { "from": "In Progress", "on": "pull_request_opened", "to": "Human Review" },
            { "from": "In Progress", "on": "pull_request_opened", "to": "Done" }
          ]
        },
        "engine_version": "1.3",
        "consumer_capabilities": ["set_state"]
      },
      "expect": { "error": "duplicate_transition" }
    },
    {
      "id": "position_dispatching_its_own_operation_is_a_position_cycle",
      "description": "The dispatch runs the position (Section 4.1) and the position's only edge dispatches the operation, so no `commit` is ever reached. Refused at validation rather than left to the flow bound (Sections 5.6, 6.10).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [
            { "on": "before:commit", "do": "run_op", "op": "commit" }
          ]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "position_cycle" }
    },
    {
      "id": "position_cycle_across_two_positions",
      "description": "No edge names the operation its own position gates, and neither operation can run: the condition is a cycle over the positions, not an edge naming itself (Sections 4.1, 6.10).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [
            { "on": "before:commit", "do": "run_op", "op": "push" },
            { "on": "before:push", "do": "run_op", "op": "commit" }
          ]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "position_cycle" }
    },
    {
      "id": "position_dispatching_another_operation_is_valid",
      "description": "A position's `run_op` edge is refused only where the positions form a cycle; one that dispatches an operation the cycle does not return from is ordinary (Section 6.10).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [
            { "on": "before:commit", "do": "run_op", "op": "push" }
          ]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "valid": true }
    },
    {
      "id": "cycle_through_a_typed_result_is_valid",
      "description": "`before:push` dispatches `integrate` and `integrate:ok` dispatches `push`, which re-enters the position: a cycle, but one that runs operations and whose next traversal may differ, so the flow bound holds it rather than validation refusing it (Sections 5.6, 6.10).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [
            { "on": "before:push", "do": "run_op", "op": "integrate" },
            { "on": "integrate:ok", "do": "run_op", "op": "push" }
          ]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "valid": true }
    },
    {
      "id": "unknown_operation_in_trigger_is_an_unknown_trigger",
      "description": "A trigger is recognized only as an op:reason form over a *known* operation (Section 6.5), so an unknown operation makes the trigger unrecognized rather than raising `unknown_operation`.",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [{ "on": "teleport:ok", "do": "escalate" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "unknown_trigger" }
    },
    {
      "id": "unknown_lifecycle_position_is_an_unknown_trigger",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [{ "on": "before:teleport", "do": "escalate" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "unknown_trigger" }
    },
    {
      "id": "unknown_action",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [{ "on": "#error", "do": "teleport" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "unknown_action" }
    },
    {
      "id": "unknown_operation_named_by_run_op",
      "description": "`unknown_operation` is the `run_op` argument case, distinct from an unrecognized trigger (Section 6.10).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [{ "on": "push:non_fast_forward", "do": "run_op", "op": "teleport" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "unknown_operation" }
    },
    {
      "id": "run_op_without_an_op_argument",
      "description": "An absent argument is a well-formedness failure, not an unrecognized name: `unknown_operation` names an operation the engine resolved and does not define (Section 6.10).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [{ "on": "push:non_fast_forward", "do": "run_op" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "malformed_policy" }
    },
    {
      "id": "unknown_hook_name",
      "description": "A `run` action naming a hook the `[hooks]` table does not declare.",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "hooks": { "scan-content": { "context": "in_sandbox", "run": "./scan" } },
          "edges": [{ "on": "before:commit", "do": "run", "hook": "nonexistent" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "unknown_hook" }
    },
    {
      "id": "run_without_a_hook_argument",
      "description": "The same condition at the other argument the edge schema names (Sections 5.2, 6.5).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "hooks": { "scan-content": { "context": "in_sandbox", "run": "./scan" } },
          "edges": [{ "on": "before:commit", "do": "run" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "malformed_policy" }
    },
    {
      "id": "by_prefix_without_empty_prefix_default",
      "description": "`by_prefix` requires an empty-prefix default (Sections 6.4, 6.10).",
      "given": {
        "policy": {
          "base": { "branch": "main", "resolve": "by_prefix", "prefixes": { "exp/": "experiment" } },
          "edges": []
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "base_unresolvable" }
    },
    {
      "id": "by_prefix_with_empty_prefix_default",
      "given": {
        "policy": {
          "base": { "branch": "main", "resolve": "by_prefix", "prefixes": { "": "main", "exp/": "experiment" } },
          "edges": []
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "valid": true }
    },
    {
      "id": "hook_declaring_no_run_unit",
      "description": "A `[hooks.<name>]` table that declares a hook and gives it nothing to run is the document's own defect, judged from the document alone (Sections 6.6, 6.10).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "hooks": { "scan-content": { "context": "in_sandbox" } },
          "edges": [{ "on": "before:commit", "do": "run", "hook": "scan-content" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": [],
        "bound_units": []
      },
      "expect": { "error": "malformed_policy" }
    },
    {
      "id": "hook_naming_a_unit_is_valid",
      "description": "Whether the named unit exists and can be started is a property of the worktree, not of the document, so it is not judged here; a unit the engine could not start is `hook_unanswered` at first use (Sections 4.3, 6.6).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "hooks": { "scan-content": { "context": "in_sandbox", "run": "./not-present-on-this-host" } },
          "edges": [{ "on": "before:commit", "do": "run", "hook": "scan-content" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": [],
        "bound_units": []
      },
      "expect": { "valid": true }
    },
    {
      "id": "template_body_source_without_a_bound_unit",
      "description": "A `template` body source names a repository unit the consumer must have bound; with none bound the policy cannot compose a body, and refusing here is what stops a `ship` publishing a work branch before it finds out (Sections 6.10, 10.2, 12.2).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "messages": { "pr": { "body_source": "template" } },
          "edges": []
        },
        "engine_version": "1.3",
        "consumer_capabilities": [],
        "bound_units": []
      },
      "expect": { "error": "template_unbound" }
    },
    {
      "id": "template_body_source_with_a_bound_unit",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "messages": { "pr": { "body_source": "template" } },
          "edges": []
        },
        "engine_version": "1.3",
        "consumer_capabilities": [],
        "bound_units": ["template"]
      },
      "expect": { "valid": true }
    },
    {
      "id": "auto_body_source_without_a_bound_unit_is_valid",
      "description": "Only `template` requires the unit; `auto` composes from durable inputs the consumer supplies (Section 10.2).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "messages": { "pr": { "body_source": "auto" } },
          "edges": []
        },
        "engine_version": "1.3",
        "consumer_capabilities": [],
        "bound_units": []
      },
      "expect": { "valid": true }
    },
    {
      "id": "set_state_edge_without_a_capable_consumer",
      "description": "A set_state binding without a consumer that can apply it is a configuration error (Section 6.10).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [{ "on": "create_pr:created", "do": "set_state", "target": "Human Review" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "set_state_unbound" }
    },
    {
      "id": "set_state_edge_with_a_capable_consumer",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [{ "on": "create_pr:created", "do": "set_state", "target": "Human Review" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": ["set_state"]
      },
      "expect": { "valid": true }
    },
    {
      "id": "transition_binding_without_a_capable_consumer",
      "description": "The transition graph is a set of set_state bindings (Section 6.7) and is validated the same way.",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [],
          "tracker_transitions": [
            { "from": "In Progress", "on": "pull_request_opened", "to": "Human Review" }
          ]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "set_state_unbound" }
    },
    {
      "id": "notify_edge_without_a_capable_consumer_is_valid",
      "description": "Only set_state binds a capable consumer at validation; notify degrades to a surfaced no-op instead (Sections 5.2, 6.10).",
      "given": {
        "policy": {
          "base": { "branch": "main" },
          "edges": [{ "on": "push:ok", "do": "notify", "channel": "team" }]
        },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "valid": true }
    },
    {
      "id": "version_floor_above_running_version",
      "description": "An engine below the floor refuses to run, fail-closed (Section 8.5).",
      "given": {
        "policy": { "engine": { "version_floor": "2.0" }, "base": { "branch": "main" }, "edges": [] },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "version_floor_unmet" }
    },
    {
      "id": "version_floor_above_running_minor",
      "given": {
        "policy": { "engine": { "version_floor": "1.4" }, "base": { "branch": "main" }, "edges": [] },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "version_floor_unmet" }
    },
    {
      "id": "version_floor_equal_to_running_version",
      "description": "Equal is not below the floor.",
      "given": {
        "policy": { "engine": { "version_floor": "1.3" }, "base": { "branch": "main" }, "edges": [] },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "valid": true }
    },
    {
      "id": "version_floor_below_running_version",
      "given": {
        "policy": { "engine": { "version_floor": "1.0" }, "base": { "branch": "main" }, "edges": [] },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "valid": true }
    },
    {
      "id": "version_floor_is_not_a_version",
      "description": "A floor the engine cannot read is `malformed_policy`; `version_floor_unmet` names a floor it read and does not satisfy (Sections 6.2, 6.10, 8.5). The refusal is the same either way.",
      "given": {
        "policy": { "engine": { "version_floor": "latest" }, "base": { "branch": "main" }, "edges": [] },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "malformed_policy" }
    },
    {
      "id": "version_floor_with_a_patch_component",
      "description": "The version grammar is `MAJOR.MINOR` (Section 8.5), so a third component is not a floor the engine compares.",
      "given": {
        "policy": { "engine": { "version_floor": "1.2.3" }, "base": { "branch": "main" }, "edges": [] },
        "engine_version": "1.3",
        "consumer_capabilities": []
      },
      "expect": { "error": "malformed_policy" }
    }
  ]
}
